# Puerto local del contenedor (Nginx en el host apunta a 127.0.0.1:APP_PORT)
APP_PORT=3000

# Imagen Docker publicada por GitHub Actions en GHCR (actualizada automáticamente en deploy)
APP_IMAGE=ghcr.io/tu-usuario/tu-repositorio:latest

# Credenciales de PostgreSQL (generar contraseña fuerte en el servidor)
POSTGRES_USER=expert_user
POSTGRES_PASSWORD=reemplazar_con_password_seguro
POSTGRES_DB=respiratory_expert

# Solo necesario si ejecuta Next.js localmente fuera de Docker
DATABASE_URL=postgresql://expert_user:reemplazar_con_password_seguro@localhost:5432/respiratory_expert?schema=public
